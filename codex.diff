.score-box span,
.content-heading span,
.block-title span {
  color: #9ba5bb;
  font-size: 12px;
  font-weight: 800;
  text-transform: uppercase;
}

.score-box strong {
  display: block;
  margin-top: 4px;
  color: #b9b1ff;
  font-size: 32px;
}

.interview-tabs {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.interview-tabs button {
  width: 100%;
  min-height: 42px;
  padding: 0 12px;
  border: 1px solid #3b4252;
  border-radius: 8px;
  background: transparent;
  color: #f7f7fb;
  font-size: 14px;
  font-weight: 700;
  text-align: left;
  cursor: pointer;
}

.interview-tabs button:hover,
.interview-tabs button.active {
  background: #252b38;
  border-color: #8a7cff;
}

.interview-main {
  padding: 34px;
  overflow: auto;
}

.content-heading {
  margin-bottom: 18px;
}

.content-heading h1 {
  margin-top: 6px;
  font-size: 32px;
  line-height: 1.15;
}

.question-list {
  display: grid;
  gap: 16px;
}

.report-block {
  padding: 22px;
  border: 1px solid #343b49;
  border-radius: 8px;
  background: #171a20;
}

.block-title h2 {
  margin-top: 8px;
  font-size: 20px;
  line-height: 1.35;
}

.report-block section,
.report-block ul {
  margin-top: 18px;
}

.report-block h3 {
  margin-bottom: 6px;
  color: #b9b1ff;
  font-size: 14px;
}

.report-block p,
.report-block li,
.skill-list p {
  color: #c4cad7;
  line-height: 1.7;
}

.report-block ul {
  padding-left: 20px;
}

.interview-right h2 {
  margin-bottom: 16px;
  font-size: 20px;
}

.skill-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.skill-chip {
  width: 100%;
  padding: 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  border: 1px solid #343b49;
  border-radius: 8px;
  background: #191d25;
}

.skill-chip span {
  font-weight: 700;
}

.severity {
  padding: 5px 8px;
  border-radius: 999px;
  color: #ffffff;
  font-size: 11px;
  line-height: 1;
  text-transform: uppercase;
}

.severity.low {
  background: #2f7d4c;
}

.severity.medium {
  background: #b56a20;
}

.severity.high {
  background: #b43e4a;
}

.interview-state,
.interview-empty {
  color: #c4cad7;
}

.interview-state.error {
  color: #ffb4b4;
}

.interview-empty h1 {
  margin-bottom: 14px;
}

.create-report-link {
  color: #b9b1ff;
  font-weight: 800;
}

@media (max-width: 1120px) {
  .interview-page {
    grid-template-columns: 210px minmax(0, 1fr);
  }

  .interview-right {
    min-height: auto;
    grid-column: 1 / -1;
    border-left: none;
    border-top: 1px solid #343b49;
  }

  .skill-chip {
    width: fit-content;
  }
}

@media (max-width: 760px) {
  .interview-page {
    grid-template-columns: 1fr;
  }

  .interview-left,
  .interview-right {
    min-height: auto;
    padding: 18px 16px;
    border-left: none;
    border-right: none;
  }

  .interview-tabs {
    flex-direction: row;
    overflow-x: auto;
  }

  .interview-tabs button {
    min-width: 170px;
  }

  .interview-main {
    padding: 24px 16px;
  }
}
Frontend/src/features/interview/style/reports.scss
.reports-page {
  min-height: calc(100vh - 72px);
  padding: 34px;
  background: #101114;
}

.reports-header {
  max-width: 1180px;
  margin: 0 auto 22px;
}

.reports-header p {
  color: #8a7cff;
  font-size: 13px;
  font-weight: 800;
  text-transform: uppercase;
}

.reports-header h1 {
  margin-top: 6px;
  font-size: 32px;
}

.reports-grid {
  max-width: 1180px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 16px;
}

.report-card,
.empty-reports {
  border: 1px solid #343b49;
  border-radius: 8px;
  background: #171a20;
  color: #f7f7fb;
}

.report-card {
  min-height: 210px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  text-decoration: none;
  transition: border-color 0.2s ease, transform 0.2s ease;
}

.report-card:hover {
  border-color: #8a7cff;
  transform: translateY(-2px);
}

.score-pill {
  width: fit-content;
  padding: 6px 10px;
  display: inline-flex;
  border-radius: 999px;
  background: #2e3140;
  color: #b9b1ff;
  font-size: 13px;
  font-weight: 800;
}

.report-card h2 {
  margin-top: 14px;
  font-size: 18px;
  line-height: 1.35;
}

.report-card p {
  color: #aeb5c5;
  font-size: 13px;
}

.report-card > span:last-child,
.report-link {
  color: #b9b1ff;
  font-weight: 800;
  text-decoration: none;
}

.reports-message,
.empty-reports {
  max-width: 1180px;
  margin: 0 auto;
}

.reports-message.error {
  color: #ffb4b4;
}

.empty-reports {
  padding: 28px;
}

.empty-reports p {
  margin: 8px 0 18px;
  color: #aeb5c5;
}

@media (max-width: 720px) {
  .reports-page {
    padding: 22px 16px;
  }
}